{
  "name": "sharlie-gate",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Local-first context pruner, cache stabilizer, and penny-accurate token ledger.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liviu-stefan-pit/sharlie-gate.git"
  },
  "engines": {
    "node": ">=24.11"
  },
  "bin": {
    "sharlie-gate": "./dist/sharlie-gate.mjs"
  },
  "exports": {
    ".": "./dist/sharlie-gate.mjs"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "smoke": "node dist/sharlie-gate.mjs --version"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "ignore": "^7.0.5",
    "js-tiktoken": "^1.0.21",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.4.2",
    "web-tree-sitter": "^0.27.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.7.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "fast-check": "^4.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
